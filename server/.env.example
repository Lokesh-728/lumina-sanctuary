# Application Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection URL (Local MongoDB Compass or Cloud Atlas)
# Local Compass format: "mongodb://localhost:27017/lumina_db?replicaSet=rs0" or "mongodb://127.0.0.1:27017/lumina_db"
# Cloud Atlas format: "mongodb+srv://<username>:<password>@cluster0.mongodb.net/lumina_db?retryWrites=true&w=majority"
DATABASE_URL="mongodb://127.0.0.1:27017/lumina_db"

# Authentication & JWT Security
JWT_SECRET=super_secret_access_key_change_in_production_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Redis (Caching & Rate Limiting & BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (Resend Service)
RESEND_API_KEY=re_123456789_your_key_here
MAIL_FROM="Lumina Sanctuary <noreply@luminaapp.com>"

# File Storage (AWS S3 / Cloudflare R2)
STORAGE_ENDPOINT=https://account_id.r2.cloudflarestorage.com
STORAGE_BUCKET_NAME=lumina-assets
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_PUBLIC_URL=https://assets.luminaapp.com

# Monitoring & Logs
SENTRY_DSN=
LOG_LEVEL=debug
